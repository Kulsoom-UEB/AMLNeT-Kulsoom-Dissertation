# =============================================================================
# AMLNet Dissertation - Git ignore rules
# =============================================================================

# ---- Dataset -----------------------------------------------------------------
# AMLNet.csv is ~691 MB, well over GitHub's 100 MB per-file limit.
# Download it from Zenodo (DOI 10.5281/zenodo.16736515) into data/raw/ instead.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Processed Parquet files are regenerated by running the pipeline
data/processed/*
!data/processed/.gitkeep

# ---- Model artefacts ---------------------------------------------------------
# The fitted pipeline is large; final_model_config.json IS committed because it
# records the selected model, hyperparameters and threshold.
models/*.joblib
models/*.pkl

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ---- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# ---- IDE ---------------------------------------------------------------------
.idea/
.vscode/
*.iml

# ---- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs and temp -----------------------------------------------------------
*.log
*.tmp
.ipynb_checkpoints/
